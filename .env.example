# --- Database ---
# Zero-setup default (SQLite). Swap to a Postgres URL to go live:
# DATABASE_URL="postgresql://user:password@host:5432/dbname"
DATABASE_URL="file:./dev.db"

# --- Auth ---
NEXTAUTH_SECRET="dev-secret-change-me"
NEXTAUTH_URL="http://localhost:3000"

# --- Payments (Stripe) ---
# Leave unset to use the built-in mock-payment path (test mode UI, real
# order/project creation code, no external calls).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""

# --- Email ---
# Leave unset to log emails to the console + email_events table instead of
# sending them.
RESEND_API_KEY=""
EMAIL_FROM="book@patientprofits.com"

# --- Order alerts ---
# Every order emails OWNER_ALERT_EMAIL (default: the support address). To also
# get a TEXT, create a Twilio account and set all four. Leave unset for email only.
OWNER_ALERT_EMAIL=""
OWNER_ALERT_PHONE=""        # your phone, E.164, e.g. +15555550123
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""       # the Twilio number texts come from, E.164

# --- AI ---
# Leave unset to run agents in mock mode (structured placeholder output).
ANTHROPIC_API_KEY=""

# --- App ---
APP_BASE_URL="http://localhost:3000"
ADMIN_SEED_EMAIL="book@patientprofits.com"
ADMIN_SEED_PASSWORD="change-me-now"

# Klarna and Afterpay at card checkout. Leave off until BOTH are enabled in Stripe (Settings, Payment methods) and Stripe
# shows your account as eligible. Both providers exclude business-to-business sales; read Stripe's eligibility screen.
BNPL_ENABLED=""
