// Patient Creations — data model
// Postgres (Neon), matching production. Local dev also points at Postgres
// now (see .env) so dev and prod never diverge on SQL dialect.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Identity ----------
// Note: enum fields below are plain `String` because the SQLite connector
// does not support native Prisma enums. Valid values are validated at the
// application layer via the union types in lib/types.ts.

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String?
  role          String    @default("CUSTOMER") // UserRole
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  customer      Customer?
  notifications Notification[]
}

model Customer {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id])
  referralCode      String   @unique
  referredByCode    String?
  createdAt         DateTime @default(now())

  orders            Order[]
  projects          Project[]
  reviews           Review[]
  referral          Referral?
  referredClicks    ReferralClick[] @relation("ReferredClicks")
  commissionsEarned Commission[]    @relation("CommissionEarner")
  notes             CustomerNote[]
  adSubscriptions   AdSubscription[]
}

// A CRM note an admin leaves on a customer record — not visible to the customer.
model CustomerNote {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  body       String
  authorName String   @default("Trenton")
  createdAt  DateTime @default(now())
}

// ---------- Catalog ----------

model Product {
  id            String    @id @default(cuid())
  slug          String    @unique
  name          String
  category      String
  type          String    @default("PRIMARY") // ProductType
  description   String
  priceCents    Int
  setupFeeCents Int       @default(0) // portion of priceCents that's a per-unit setup fee, waived in bulk (see BULK_SETUP_WAIVER_MIN_QTY)
  billingPeriod String?   // null = one-time, e.g. "monthly" for subscriptions
  revisionLimit Int       @default(2)
  turnaround    String?   // e.g. "2-3 weeks" — display-only estimate
  active        Boolean   @default(true)
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())

  variants      ProductVariant[]
  orderItems    OrderItem[]
}

model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id])
  name       String
  priceCents Int
  active     Boolean     @default(true)
  orderItems OrderItem[]
}

// ---------- Orders / Payments ----------

model Order {
  id             String      @id @default(cuid())
  customerId     String
  customer       Customer    @relation(fields: [customerId], references: [id])
  status         String      @default("PENDING") // OrderStatus
  subtotalCents  Int
  discountCents  Int         @default(0)
  deliverySpeed  String      @default("standard") // DeliverySpeed
  rushFeeCents   Int         @default(0)
  shippingCents  Int         @default(0) // physical-goods orders only (e.g. NFC cards) — see lib/payments/shipping.ts
  shippingBoxLabel String?   // which flat-rate box the shippingCents quote was based on, kept for transparency in the order summary
  totalCents     Int
  couponCode     String?
  paymentMethod  String      @default("stripe") // PaymentMethod — chosen on the payment-method step of checkout
  stripeSessionId String?    @unique
  campaignSource String?
  createdAt      DateTime    @default(now())
  paidAt         DateTime?

  items          OrderItem[]
  payments       Payment[]
  project        Project?
  nfcIntake      NfcIntake?
  websiteIntake  WebsiteIntake?
}

// Physical stock on hand for merch (NFC cards). Tracked per design/color
// rather than per Stripe product, since some designs (Google Review) come
// in two colors that checkout doesn't ask the customer to choose between —
// admin fulfills those manually and adjusts the matching bucket by hand.
// productSlug links a row to a Product for automatic decrement on a paid
// order; left null when the mapping is ambiguous (e.g. the color split).
model InventoryItem {
  id                String   @id @default(cuid())
  sku               String   @unique
  label             String
  productSlug       String?
  quantityOnHand    Int      @default(0)
  lowStockThreshold Int      @default(5)
  updatedAt         DateTime @updatedAt
}

// Post-purchase questionnaire collected on the order-confirmation page for
// NFC card orders — what the card should say/link to and how to reach the
// customer with proof art before the card is programmed and shipped.
model NfcIntake {
  id              String   @id @default(cuid())
  orderId         String   @unique
  order           Order    @relation(fields: [orderId], references: [id])
  socialMediaPage String?
  nfcContent      String
  targetLink      String
  cardColor       String?  // "black" | "white" — only asked for designs with a color choice (currently Google Review)
  phone           String
  email           String
  createdAt       DateTime @default(now())
}

model OrderItem {
  id              String          @id @default(cuid())
  orderId         String
  order           Order           @relation(fields: [orderId], references: [id])
  productId       String
  product         Product         @relation(fields: [productId], references: [id])
  productVariantId String?
  productVariant  ProductVariant? @relation(fields: [productVariantId], references: [id])
  quantity        Int             @default(1)
  priceCents      Int
}

model Payment {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  provider    String   // PaymentProvider
  providerRef String?
  amountCents Int
  status      String   // OrderStatus
  createdAt   DateTime @default(now())
}

// ---------- Projects / Production ----------
// ProjectState values: DRAFT, PAID, INTAKE_REQUIRED, QUEUED, RESEARCH,
// STRATEGY, CONCEPT, GENERATION, BUILD, AUTOMATION, QA, PERCEPTION,
// REVISION, DELIVERY_READY, DELIVERED, REVIEW_REQUESTED, COMPLETED,
// EXCEPTION, CANCELLED (see lib/types.ts).

model Project {
  id           String       @id @default(cuid())
  orderId      String       @unique
  order        Order        @relation(fields: [orderId], references: [id])
  customerId   String
  customer     Customer     @relation(fields: [customerId], references: [id])
  name         String
  state        String       @default("DRAFT") // ProjectState
  retryCount   Int          @default(0)
  exceptionNote String?
  statusToken  String?      @unique // powers the public, no-login /status/[token] page
  productionStartedAt DateTime? // set once, atomically, when production begins (payment + intake both done)
  previewToken String?      // random 128-bit token for the private /preview/[token] page where the customer approves the website
  websiteBuilds WebsiteBuild[]
  careSubscriptions CareSubscription[]
  @@index([previewToken])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  bible        CreativeBible?
  tasks        ProjectTask[]
  files        ProjectFile[]
  contexts     ProjectContext[]
  assets       Asset[]
  agentRuns    AgentRun[]
  qaReports    QaReport[]
  perceptionReports PerceptionReport[]
  deliverables Deliverable[]
  revisions    Revision[]
  review       Review?
  updates      ProjectUpdate[]
  messages     ProjectMessage[]
}

// A plain-language progress note Trenton posts for a customer — shown on
// the public status page and, optionally, emailed. Distinct from AuditLog
// (which is internal/technical) and CustomerNote (which is private/admin-only).
model ProjectUpdate {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  message    String
  authorName String   @default("Trenton")
  notifyEmail Boolean @default(false)
  createdAt  DateTime @default(now())
}

// The customer's business information for a website build. The basics are
// captured at checkout; the rest is filled in through the no-login intake
// wizard, which is reached with the unguessable `token` (same pattern as the
// private status link). Production starts once status is COMPLETE and paid.
model WebsiteIntake {
  id              String    @id @default(cuid())
  orderId         String    @unique
  order           Order     @relation(fields: [orderId], references: [id])
  token           String    @unique
  status          String    @default("STARTED") // STARTED | COMPLETE
  businessName    String
  businessType    String
  phone           String
  existingWebsite String?
  description     String?
  address         String?
  hours           String?
  services        String?
  pricing         String?
  bookingUrl      String?
  socialUrls      String?   // one per line
  logoUrl         String?
  colors          String?
  fontStyle       String?
  styleNotes      String?
  mediaLinks      String?   // one per line: links to photos and videos
  goal            String?   // CALL | TEXT | BOOK | QUOTE | VISIT | BUY | FORM | OTHER
  goalNotes       String?
  startedAt       DateTime? // first time the wizard was opened
  completedAt     DateTime?
  contentConfirmedAt DateTime? // when the customer confirmed the information and materials are accurate and theirs to use
  reminderCount   Int       @default(0) // reminder emails sent while waiting on the customer
  lastReminderAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// Real, published customer results only. Nothing renders until `published` is
// true, and nothing is seeded, so the site never shows invented case studies.
model CaseStudy {
  id                String   @id @default(cuid())
  slug              String   @unique
  businessName      String
  industry          String
  problem           String
  improvements      String   // one per line
  beforeUrl         String?
  afterUrl          String?
  testimonial       String?  // only with the customer's permission
  testimonialAuthor String?
  published         Boolean  @default(false)
  createdAt         DateTime @default(now())
}

// Two-way thread on a customer's private status page. Customers write from the
// link; the concierge agent (or Trenton) answers. `escalated` marks messages the
// agent couldn't or shouldn't handle (billing, scope changes, anything unclear).
model ProjectMessage {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  sender     String   // "CUSTOMER" | "AGENT" | "ADMIN"
  authorName String
  body       String
  escalated  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([projectId, createdAt])
}

model CreativeBible {
  id            String  @id @default(cuid())
  projectId     String  @unique
  project       Project @relation(fields: [projectId], references: [id])
  customerJson      String // JSON: customer info
  businessJson      String
  objectiveJson     String
  audienceJson      String
  offerJson         String
  brandJson         String
  voiceJson         String
  designJson        String
  technologyJson    String
  requirementsJson  String
  contentJson       String
  assetsJson        String
  referencesJson    String
  decisionsJson     String
  constraintsJson   String
  qaResultsJson     String @default("[]")
  deploymentJson    String @default("{}")
  deliveryJson      String @default("{}")
  revisionHistoryJson String @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ProjectTask {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  phase       String   // ProjectState
  label       String
  weight      Int      // percentage points this phase contributes when complete
  status      String   @default("PENDING") // TaskStatus
  attempt     Int      @default(0)
  startedAt   DateTime?
  completedAt DateTime?
  notes       String?

  agentRuns   AgentRun[]
}

model ProjectFile {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  path      String
  kind      String
  createdAt DateTime @default(now())
}

model ProjectContext {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  key       String
  valueJson String
  createdAt DateTime @default(now())
}

// ---------- Assets ----------

model Asset {
  id        String   @id @default(cuid())
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])
  category  String
  name      String
  path      String
  createdAt DateTime @default(now())

  versions  AssetVersion[]
}

model AssetVersion {
  id        String   @id @default(cuid())
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id])
  version   Int
  path      String
  createdAt DateTime @default(now())
}

// ---------- Agents ----------

model Agent {
  id           String @id @default(cuid())
  key          String @unique // e.g. "research", "orchestrator"
  name         String
  mission      String
  maxRetries   Int    @default(5)
  maxTimeMs    Int    @default(60000)
  budgetCents  Int    @default(0)

  runs         AgentRun[]
}

model AgentRun {
  id          String       @id @default(cuid())
  agentId     String
  agent       Agent        @relation(fields: [agentId], references: [id])
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id])
  taskId      String?
  task        ProjectTask? @relation(fields: [taskId], references: [id])
  status      String       @default("RUNNING") // AgentRunStatus
  inputJson   String
  outputJson  String?
  failureReason String?
  costCents   Int          @default(0)
  durationMs  Int?
  startedAt   DateTime     @default(now())
  finishedAt  DateTime?

  outputs     AgentOutput[]
}

model AgentOutput {
  id          String   @id @default(cuid())
  agentRunId  String
  agentRun    AgentRun @relation(fields: [agentRunId], references: [id])
  kind        String
  valueJson   String
  createdAt   DateTime @default(now())
}

// ---------- QA / Perception ----------

model QaReport {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  category    String   // functional | visual | ux | technical | conversion
  passed      Boolean
  findingsJson String
  createdAt   DateTime @default(now())
}

model PerceptionReport {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id])
  firstImpression Int
  clarity        Int
  trust          Int
  premiumFeel    Int
  emotionalImpact Int
  visualHierarchy Int
  desire         Int
  friction       Int
  conversionConfidence Int
  passed         Boolean
  notes          String?
  createdAt      DateTime @default(now())
}

// ---------- Delivery / Revisions / Reviews ----------

model Deliverable {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  version   Int      @default(1)
  path      String
  notes     String?
  createdAt DateTime @default(now())
}

model Revision {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id])
  notes         String
  impactedAssetsJson String @default("[]")
  status        String   @default("REQUESTED") // RevisionStatus
  createdAt     DateTime @default(now())
  completedAt   DateTime?
}

model Review {
  id             String   @id @default(cuid())
  projectId      String   @unique
  project        Project  @relation(fields: [projectId], references: [id])
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id])
  rating         Int
  text           String?
  testimonial    String?
  canPublish     Boolean  @default(false)
  canUsePortfolio Boolean @default(false)
  createdAt      DateTime @default(now())
}

// ---------- Referrals / Commissions ----------

model Referral {
  id           String   @id @default(cuid())
  customerId   String   @unique
  customer     Customer @relation(fields: [customerId], references: [id])
  code         String   @unique
  createdAt    DateTime @default(now())

  clicks       ReferralClick[]
  commissions  Commission[]
}

model ReferralClick {
  id                  String    @id @default(cuid())
  referralId          String
  referral            Referral  @relation(fields: [referralId], references: [id])
  ipHash              String?
  userAgent           String?
  convertedCustomerId String?
  convertedCustomer   Customer? @relation("ReferredClicks", fields: [convertedCustomerId], references: [id])
  createdAt           DateTime  @default(now())
}

model Commission {
  id               String    @id @default(cuid())
  referralId       String
  referral         Referral  @relation(fields: [referralId], references: [id])
  earnerCustomerId String
  earner           Customer  @relation("CommissionEarner", fields: [earnerCustomerId], references: [id])
  orderId          String?
  state            String    @default("CLICKED") // CommissionState
  grossRevenueCents Int      @default(0)
  commissionCents   Int      @default(0)
  pendingUntil      DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  payout           Payout? @relation(fields: [payoutId], references: [id])
  payoutId         String?
}

model Payout {
  id          String   @id @default(cuid())
  customerId  String
  amountCents Int
  status      String   @default("PENDING") // PENDING | PAID | FAILED
  createdAt   DateTime @default(now())
  paidAt      DateTime?

  commissions Commission[]
}

// ---------- Email / Marketing / Analytics ----------

model EmailEvent {
  id         String   @id @default(cuid())
  toEmail    String
  template   String
  payloadJson String
  provider   String   // console | resend
  status     String   @default("SENT")
  createdAt  DateTime @default(now())
}

model Campaign {
  id             String   @id @default(cuid())
  name           String
  channel        String
  status         String   @default("DRAFT") // CampaignStatus
  dailyBudgetCents Int
  totalSpendCents  Int    @default(0)
  performanceThresholdJson String @default("{}")
  createdAt      DateTime @default(now())

  creatives      AdCreative[]
}

model AdCreative {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id])
  version     Int      @default(1)
  approved    Boolean  @default(false)
  contentJson String
  createdAt   DateTime @default(now())
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  name      String
  payloadJson String
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  audience  String   @default("customer") // customer | admin
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  event      String
  entityType String?
  entityId   String?
  payloadJson String  @default("{}")
  createdAt  DateTime @default(now())
}

// One generated version of a customer's website. `siteJson` is the structured
// content and design the page was rendered from; `html` is the finished static
// page (also the artifact that gets deployed).
model WebsiteBuild {
  id         String    @id @default(cuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id])
  version    Int       @default(1)
  status     String    @default("PREVIEW") // PREVIEW | APPROVED | LIVE | SUPERSEDED
  siteJson   String
  html       String
  qaJson     String
  copyMode   String    // "model" (AI-written from the customer's facts) | "template" (the customer's own wording)
  liveUrl    String?
  approvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([projectId, version])
}

// The monthly website care plan. One row per Stripe subscription; Stripe events
// keep `status` current. Money is only ever taken by Stripe.
model CareSubscription {
  id                   String    @id @default(cuid())
  projectId            String
  project              Project   @relation(fields: [projectId], references: [id])
  customerId           String
  stripeCustomerId     String?
  stripeSubscriptionId String    @unique
  status               String    @default("ACTIVE") // ACTIVE | PAST_DUE | CANCELED
  priceCents           Int
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([projectId])
}

// A local business we might sell a website to. Tracked by hand: nothing is ever
// sent to a prospect automatically.
model Prospect {
  id             String    @id @default(cuid())
  dedupeKey      String    @unique // lowercase website host, else "name|city"
  businessName   String
  industry       String?   // an industry slug from lib/site/industries.ts
  city           String?
  phone          String?
  email          String?
  website        String?
  source         String?
  status         String    @default("NEW") // NEW | AUDITED | CONTACTED | REPLIED | CALL_BOOKED | WON | LOST | DO_NOT_CONTACT
  nextFollowUpAt DateTime?
  contactedAt    DateTime?
  auditJson      String?
  auditedAt      DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([nextFollowUpAt])
}

// A recorded "I agree": which version of the legal terms someone accepted, when,
// and from where. This is the evidence that makes the terms (including
// arbitration) enforceable, and it is what gets shown if a payment is disputed.
model TermsAcceptance {
  id         String   @id @default(cuid())
  scope      String   // ORDER | CARE_PLAN | AD_PLAN
  refId      String   // the order id, the project id for a care plan, or the ad subscription id
  customerId String?
  version    String
  ip         String?
  userAgent  String?
  acceptedAt DateTime @default(now())

  @@index([scope, refId])
  @@index([customerId])
}

// A customer's Monthly Ads plan (see lib/ads/plans.ts). Reached through a private
// link (manageToken), the same capability model as the project status page.
model AdSubscription {
  id                   String    @id @default(cuid())
  customerId           String
  customer             Customer  @relation(fields: [customerId], references: [id])
  planSlug             String
  priceCents           Int
  status               String    @default("PENDING") // PENDING | ACTIVE | PAST_DUE | CANCELED
  manageToken          String    @unique
  businessName         String
  phone                String?
  stripeCustomerId     String?
  stripeSubscriptionId String?   @unique
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  briefJson            String    @default("{}")
  briefUpdatedAt       DateTime?
  activatedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  deliveries           AdDelivery[]

  @@index([customerId])
  @@index([status])
}

// One batch of finished work handed to the customer, logged by an admin. Files are
// delivered by link or email (nothing is stored here), so this holds a note and a link.
model AdDelivery {
  id             String         @id @default(cuid())
  subscriptionId String
  subscription   AdSubscription @relation(fields: [subscriptionId], references: [id])
  period         String         // "YYYY-MM", Eastern time
  itemsCount     Int            @default(0)
  note           String
  url            String?
  createdAt      DateTime       @default(now())

  @@index([subscriptionId, period])
}

// Someone who asked not to get follow-up emails. Checked before every follow-up is sent. One row per address.
model EmailOptOut {
  id        String   @id @default(cuid())
  email     String   @unique
  reason    String?
  createdAt DateTime @default(now())
}

// A paid Growth Audit. The report is built when the request is made (the visitor's homepage is read once), and only
// shown in full after the fee is paid. The fee comes back as a single-use credit code toward the first order.
model GrowthAudit {
  id              String    @id @default(cuid())
  token           String    @unique // powers the private /audit/report/[token] page
  email           String
  businessName    String
  prospectId      String?
  inputJson       String
  reportJson      String
  factsJson       String?   // extra things read from their homepage, for the owner's briefing only
  briefingJson    String?   // the owner's briefing: what they need and what to offer
  amountCents     Int
  status          String    @default("PENDING") // PENDING | PAID
  stripeSessionId String?   @unique
  paidAt          DateTime?
  creditCode      String?   @unique
  creditExpiresAt DateTime?
  creditUsedAt    DateTime?
  createdAt       DateTime  @default(now())

  @@index([email])
  @@index([status])
}
